<% analysis = analysis.is_a?(Hash) ? analysis : {} %>
<div class="card" data-waf-analysis>
  <div class="card-header">
    <h3 class="card-title">WAF Analysis</h3>
  </div>
  <div class="card-body">
    <p><strong><%= local_assigns[:banned] ? "Request that triggered the ban" : "Requested path" %></strong></p>
    <div style="font-family: monospace; font-size: 13px; background: #F4F5F7; padding: 0.75rem; border-radius: 6px; overflow-wrap: anywhere;">
      <% if analysis["request_path"].present? %>
        <span><%= analysis["request_method"] %></span>
        <span data-request-path><%= analysis["request_path"] %></span>
      <% else %>
        <span data-request-path>Not recorded</span>
      <% end %>
    </div>
    <% if analysis["patterns"].is_a?(Array) %>
      <ul>
        <% analysis["patterns"].each do |pattern| %>
          <% next unless pattern.is_a?(Hash) %>
          <li><%= pattern["description"] %> (<%= pattern["rule_id"] %>, <%= pattern["severity"] %>)</li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
